#!/usr/bin/env bash

set -u

PROGRAM_NAME="riceutil"
VERSION="1.6.0"

print_usage() {
  cat <<'EOF'
Kullanım:
  riceutil binds     skhd alt komutlarını gösterir
  riceutil wm        yabai alt komutlarını gösterir
  riceutil reload    skhd ve yabai config'lerini yeniler
  riceutil kitty     kitty.conf dosyasını Vim ile açar
  riceutil zsh       .zshrc dosyasını Vim ile açar
  riceutil doctor    yabai/skhd durumunu, config'lerini ve loglarını basar
  riceutil update    Homebrew paketlerini günceller
  riceutil status    yabai, skhd, Homebrew ve duvar kağıdının kısa durumu
  riceutil gui       Riceutil uygulamasını (GUI) açar
  riceutil help      bu yardımı gösterir

Duvar kağıdı (ASCII Wallpaper, kısaltma: riceutil wp):
  riceutil wallpaper                 durumu gösterir
  riceutil wallpaper install         indirir, derler, ~/Applications'a kurar ve başlatır
  riceutil wallpaper update          depoyu çeker, yeniden derler ve kurar
  riceutil wallpaper start|stop|restart
  riceutil wallpaper themes          kurulu temaları listeler (* = etkin tema)
  riceutil wallpaper packs           tema paketleri (Klasik dahili; Hyprland, Anime ... ayrı indirilir)
  riceutil wallpaper pack add <paket>...     paketi indirir ve kurar
  riceutil wallpaper pack remove <paket>...  paketi kaldırır
  riceutil wallpaper theme <kimlik>  temayı değiştirir
  riceutil wallpaper next            sonraki temaya geçer
  riceutil wallpaper panel on|off    sistem paneli
  riceutil wallpaper clock on|off    saat
  riceutil wallpaper name on|off     köşedeki tema adı
  riceutil wallpaper rotate <dakika> temaları sırayla değiştirir (0 = kapalı)
  riceutil wallpaper saver           ekran koruyucuyu kurar ve ayarlarını açar

Ortam değişkenleri:
  RICEUTIL_EDITOR         Editör komutu (varsayılan: vim)
  RICEUTIL_SKHD_CONFIG    skhd config yolunu zorla
  RICEUTIL_YABAI_CONFIG   yabai config yolunu zorla
  RICEUTIL_KITTY_CONFIG   Kitty config yolunu zorla
  RICEUTIL_ZSH_CONFIG     Zsh config yolunu zorla
  RICEUTIL_WALLPAPER_DIR  Wallpaper deposunun klasörü (varsayılan: ~/.local/share/riceutil/Wallpaper)
  RICEUTIL_WALLPAPER_REF  kurulacak dal veya etiket (varsayılan: deponun ana dalı)

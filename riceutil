#!/usr/bin/env bash

set -u

PROGRAM_NAME="riceutil"
VERSION="1.4.0"

print_usage() {
  cat <<'EOF'
Kullanım:
  riceutil binds     skhd alt komutlarını gösterir
  riceutil wm        yabai alt komutlarını gösterir
  riceutil reload    skhd ve yabai config'lerini yeniler
  riceutil kitty     kitty.conf dosyasını Vim ile açar
  riceutil zsh       .zshrc dosyasını Vim ile açar
  riceutil doctor    yabai/skhd durumunu, config'lerini ve loglarını basar
  riceutil update    Homebrew paketlerini günceller
  riceutil help      bu yardımı gösterir

Ortam değişkenleri:
  RICEUTIL_EDITOR       Editör komutu (varsayılan: vim)
  RICEUTIL_SKHD_CONFIG  skhd config yolunu zorla
  RICEUTIL_YABAI_CONFIG yabai config yolunu zorla
  RICEUTIL_KITTY_CONFIG Kitty config yolunu zorla
  RICEUTIL_ZSH_CONFIG   Zsh config yolunu zorla
EOF
}

print_binds_usage() {
  cat <<'EOF'
Kullanım:
  riceutil binds config   skhd config dosyasını Vim ile açar
  riceutil binds reload   çalışan skhd'ye config'i yeniden yükletir
  riceutil binds help     bu yardımı gösterir
EOF
}

print_wm_usage() {
  cat <<'EOF'
Kullanım:
  riceutil wm config   yabai config dosyasını Vim ile açar
  riceutil wm reload   yabai servisini yeniden başlatıp config'i yükler
  riceutil wm mode     pencere yöneticisi modlarını gösterir
  riceutil wm help     bu yardımı gösterir
EOF
}

print_wm_mode_usage() {
  cat <<'EOF'
Kullanım:
  riceutil wm mode mac             normal macOS pencere yönetimine geçer
  riceutil wm mode yabai           yabai pencere yönetimine geçer
  riceutil wm mode stage-manager   Stage Manager'a geçer

Takma adlar:
  mac: normal, native
  stage-manager: stage, stagemanager
EOF
}

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

resolve_skhd_config() {
  if [ -n "${RICEUTIL_SKHD_CONFIG:-}" ]; then
    printf '%s\n' "$RICEUTIL_SKHD_CONFIG"
  elif [ -f "$HOME/.skhdrc" ]; then
    printf '%s\n' "$HOME/.skhdrc"
  elif [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/skhd/skhdrc" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/skhd/skhdrc"
  else
    printf '%s\n' "$HOME/.skhdrc"
  fi
}

resolve_yabai_config() {
  if [ -n "${RICEUTIL_YABAI_CONFIG:-}" ]; then
    printf '%s\n' "$RICEUTIL_YABAI_CONFIG"
  elif [ -f "$HOME/.yabairc" ]; then
    printf '%s\n' "$HOME/.yabairc"
  elif [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/yabai/yabairc" ]; then
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/yabai/yabairc"
  else
    printf '%s\n' "$HOME/.yabairc"
  fi
}

resolve_kitty_config() {
  if [ -n "${RICEUTIL_KITTY_CONFIG:-}" ]; then
    printf '%s\n' "$RICEUTIL_KITTY_CONFIG"
  elif [ -n "${KITTY_CONFIG_DIRECTORY:-}" ]; then
    printf '%s\n' "${KITTY_CONFIG_DIRECTORY%/}/kitty.conf"
  elif [ -n "${XDG_CONFIG_HOME:-}" ] && [ -f "$XDG_CONFIG_HOME/kitty/kitty.conf" ]; then
    printf '%s\n' "$XDG_CONFIG_HOME/kitty/kitty.conf"
  elif [ -f "$HOME/.config/kitty/kitty.conf" ]; then
    printf '%s\n' "$HOME/.config/kitty/kitty.conf"
  elif [ -n "${XDG_CONFIG_HOME:-}" ]; then
    printf '%s\n' "$XDG_CONFIG_HOME/kitty/kitty.conf"
  else
    printf '%s\n' "$HOME/.config/kitty/kitty.conf"
  fi
}

resolve_zsh_config() {
  if [ -n "${RICEUTIL_ZSH_CONFIG:-}" ]; then
    printf '%s\n' "$RICEUTIL_ZSH_CONFIG"
  else
    printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc"
  fi
}

open_in_editor() {
  local path="$1"
  local editor="${RICEUTIL_EDITOR:-vim}"
  local parent_directory

  command -v "$editor" >/dev/null 2>&1 || fail "'$editor' bulunamadı. Vim'i kur veya RICEUTIL_EDITOR ayarla."
  parent_directory="$(dirname "$path")"
  if [ ! -d "$parent_directory" ]; then
    mkdir -p "$parent_directory" || fail "Config klasörü oluşturulamadı: $parent_directory"
  fi
  exec "$editor" "$path"
}

print_section() {
  printf '\n===== %s =====\n' "$1"
}

print_command_version() {
  local command_name="$1"
  local command_path

  if command_path="$(command -v "$command_name" 2>/dev/null)"; then
    printf '%-8s %s\n' "$command_name:" "$command_path"
    case "$command_name" in
      yabai|skhd)
        "$command_name" --version 2>&1 | sed -n '1p' || true
        ;;
      brew)
        brew --version 2>&1 | sed -n '1p' || true
        ;;
      vim)
        vim --version 2>&1 | sed -n '1p' || true
        ;;
    esac
  else
    printf '%-8s BULUNAMADI\n' "$command_name:"
  fi
}

SEEN_FILES="
"
FOUND_CONFIGS=0
FOUND_LOGS=0

dump_file() {
  local category="$1"
  local path="$2"

  [ -f "$path" ] || return 0

  case "$SEEN_FILES" in
    *"
$path
"*) return 0 ;;
  esac
  SEEN_FILES="${SEEN_FILES}${path}
"

  if [ "$category" = "config" ]; then
    FOUND_CONFIGS=$((FOUND_CONFIGS + 1))
  else
    FOUND_LOGS=$((FOUND_LOGS + 1))
  fi

  printf '\n--- %s ---\n' "$path"
  if [ -r "$path" ]; then
    cat "$path"
    printf '\n'
  else
    printf '[okuma izni yok]\n'
  fi
}

dump_directory_files() {
  local category="$1"
  local directory="$2"
  local path

  [ -d "$directory" ] || return 0
  while IFS= read -r path; do
    dump_file "$category" "$path"
  done < <(find "$directory" -type f -print 2>/dev/null)
}

doctor() {
  local username
  local temp_root="${TMPDIR:-/tmp}"
  local path

  username="${USER:-$(id -un)}"

  printf '%s doctor %s\n' "$PROGRAM_NAME" "$VERSION"
  printf 'Tarih: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"

  print_section "Sistem"
  if command -v sw_vers >/dev/null 2>&1; then
    sw_vers 2>&1 || true
  fi
  uname -a 2>&1 || true
  printf 'Kullanıcı: %s (uid=%s)\n' "$username" "$(id -u)"
  printf 'Shell: %s\n' "${SHELL:-bilinmiyor}"

  print_section "Komutlar"
  print_command_version yabai
  print_command_version skhd
  print_command_version brew
  print_command_version vim

  print_section "Çalışan süreçler"
  if command -v pgrep >/dev/null 2>&1; then
    local running_processes=""
    running_processes="$({ pgrep -x -l yabai || true; pgrep -x -l skhd || true; } 2>/dev/null)"
    if [ -n "$running_processes" ]; then
      printf '%s\n' "$running_processes"
    else
      printf 'Çalışan yabai/skhd süreci bulunamadı.\n'
    fi
  else
    printf 'pgrep bulunamadı.\n'
  fi

  print_section "launchctl servisleri"
  if command -v launchctl >/dev/null 2>&1; then
    launchctl list 2>&1 | awk '
      tolower($0) ~ /(yabai|skhd)/ { print; found=1 }
      END { if (!found) print "yabai/skhd LaunchAgent kaydı bulunamadı." }
    ' || true
  else
    printf 'launchctl bulunamadı.\n'
  fi

  print_section "Homebrew servisleri"
  if command -v brew >/dev/null 2>&1; then
    brew services list 2>&1 | awk '
      NR == 1 { print; next }
      tolower($0) ~ /(yabai|skhd)/ { print; found=1 }
      END { if (!found) print "Homebrew servis listesinde yabai/skhd bulunamadı." }
    ' || true
  else
    printf 'brew bulunamadı.\n'
  fi

  print_section "Config dosyaları"
  dump_file config "${RICEUTIL_YABAI_CONFIG:-$(resolve_yabai_config)}"
  dump_file config "$HOME/.yabairc"
  dump_file config "${XDG_CONFIG_HOME:-$HOME/.config}/yabai/yabairc"
  dump_file config "${RICEUTIL_SKHD_CONFIG:-$(resolve_skhd_config)}"
  dump_file config "$HOME/.skhdrc"
  dump_file config "${XDG_CONFIG_HOME:-$HOME/.config}/skhd/skhdrc"

  for path in \
    "$HOME/Library/LaunchAgents/com.koekeishiya.yabai.plist" \
    "$HOME/Library/LaunchAgents/com.koekeishiya.skhd.plist" \
    "$HOME/Library/LaunchAgents/homebrew.mxcl.yabai.plist" \
    "$HOME/Library/LaunchAgents/homebrew.mxcl.skhd.plist" \
    "/Library/LaunchDaemons/com.koekeishiya.yabai.plist" \
    "/Library/LaunchDaemons/com.koekeishiya.skhd.plist"; do
    dump_file config "$path"
  done

  if [ "$FOUND_CONFIGS" -eq 0 ]; then
    printf 'Bilinen konumlarda yabai/skhd config dosyası bulunamadı.\n'
  fi

  print_section "Log dosyaları"
  for path in \
    "/tmp/yabai_${username}.out.log" \
    "/tmp/yabai_${username}.err.log" \
    "/tmp/skhd_${username}.out.log" \
    "/tmp/skhd_${username}.err.log" \
    "${temp_root%/}/yabai_${username}.out.log" \
    "${temp_root%/}/yabai_${username}.err.log" \
    "${temp_root%/}/skhd_${username}.out.log" \
    "${temp_root%/}/skhd_${username}.err.log" \
    "$HOME/Library/Logs/yabai.log" \
    "$HOME/Library/Logs/skhd.log"; do
    dump_file log "$path"
  done

  dump_directory_files log "$HOME/Library/Logs/yabai"
  dump_directory_files log "$HOME/Library/Logs/skhd"
  dump_directory_files log "$HOME/Library/Logs/Homebrew/yabai"
  dump_directory_files log "$HOME/Library/Logs/Homebrew/skhd"

  for path in "$HOME"/Library/Logs/*yabai* "$HOME"/Library/Logs/*skhd*; do
    dump_file log "$path"
  done

  if [ "$FOUND_LOGS" -eq 0 ]; then
    printf 'Bilinen konumlarda yabai/skhd log dosyası bulunamadı.\n'
  fi

  print_section "Özet"
  printf '%s config/servis dosyası ve %s log dosyası çıktılandı.\n' "$FOUND_CONFIGS" "$FOUND_LOGS"
}

update_homebrew() {
  command -v brew >/dev/null 2>&1 || fail "Homebrew bulunamadı: https://brew.sh"

  printf 'Homebrew paket bilgileri güncelleniyor...\n'
  brew update || fail "'brew update' başarısız oldu."

  printf '\nKurulu paketler güncelleniyor...\n'
  brew upgrade || fail "'brew upgrade' başarısız oldu."

  printf '\nHomebrew güncellemesi tamamlandı.\n'
}

reload_skhd() {
  if ! command -v skhd >/dev/null 2>&1; then
    printf '%s: skhd bulunamadı.\n' "$PROGRAM_NAME" >&2
    return 1
  fi

  printf 'skhd config yenileniyor...\n'
  if skhd --reload; then
    printf 'skhd config yenilendi.\n'
  else
    printf '%s: skhd config yenilenemedi. skhd çalışıyor mu?\n' "$PROGRAM_NAME" >&2
    return 1
  fi
}

reload_yabai() {
  if ! command -v yabai >/dev/null 2>&1; then
    printf '%s: yabai bulunamadı.\n' "$PROGRAM_NAME" >&2
    return 1
  fi

  printf 'yabai servisi yeniden başlatılıyor...\n'
  if yabai --restart-service; then
    printf 'yabai config yenilendi.\n'
  else
    printf '%s: yabai config yenilenemedi. Servis kurulu mu?\n' "$PROGRAM_NAME" >&2
    return 1
  fi
}

is_yabai_running() {
  command -v pgrep >/dev/null 2>&1 && pgrep -x yabai >/dev/null 2>&1
}

stop_yabai_service() {
  if ! command -v yabai >/dev/null 2>&1; then
    printf 'yabai kurulu değil; durdurma adımı atlandı.\n'
    return 0
  fi

  printf 'yabai servisi durduruluyor...\n'
  if yabai --stop-service; then
    printf 'yabai servisi durduruldu.\n'
    return 0
  fi

  if is_yabai_running; then
    printf '%s: yabai servisi durdurulamadı.\n' "$PROGRAM_NAME" >&2
    return 1
  fi

  printf 'yabai zaten çalışmıyor.\n'
}

start_yabai_service() {
  if ! command -v yabai >/dev/null 2>&1; then
    printf '%s: yabai bulunamadı. Önce yabai kurmalısın.\n' "$PROGRAM_NAME" >&2
    return 1
  fi

  if is_yabai_running; then
    printf 'yabai servisi yeniden başlatılıyor...\n'
    if yabai --restart-service; then
      printf 'yabai servisi yeniden başlatıldı.\n'
    else
      printf '%s: yabai servisi yeniden başlatılamadı.\n' "$PROGRAM_NAME" >&2
      return 1
    fi
  else
    printf 'yabai servisi başlatılıyor...\n'
    if yabai --start-service; then
      printf 'yabai servisi başlatıldı.\n'
    else
      printf '%s: yabai servisi başlatılamadı.\n' "$PROGRAM_NAME" >&2
      return 1
    fi
  fi
}

set_stage_manager() {
  local enabled="$1"

  command -v defaults >/dev/null 2>&1 || {
    printf '%s: macOS defaults komutu bulunamadı.\n' "$PROGRAM_NAME" >&2
    return 1
  }
  command -v killall >/dev/null 2>&1 || {
    printf '%s: killall komutu bulunamadı.\n' "$PROGRAM_NAME" >&2
    return 1
  }

  if ! defaults write com.apple.WindowManager GloballyEnabled -bool "$enabled"; then
    printf '%s: Stage Manager tercihi değiştirilemedi.\n' "$PROGRAM_NAME" >&2
    return 1
  fi

  printf 'Dock yeniden başlatılıyor...\n'
  if ! killall Dock; then
    printf '%s: Dock yeniden başlatılamadı.\n' "$PROGRAM_NAME" >&2
    return 1
  fi
}

switch_wm_mode() {
  local mode="$1"

  case "$mode" in
    mac|normal|native)
      stop_yabai_service || return 1
      set_stage_manager false || return 1
      printf '\nNormal macOS pencere yönetimi etkin.\n'
      ;;
    yabai)
      command -v yabai >/dev/null 2>&1 || {
        printf '%s: yabai bulunamadı. Önce yabai kurmalısın.\n' "$PROGRAM_NAME" >&2
        return 1
      }
      set_stage_manager false || return 1
      start_yabai_service || return 1
      printf '\nyabai pencere yönetimi etkin.\n'
      ;;
    stage-manager|stage|stagemanager)
      stop_yabai_service || return 1
      set_stage_manager true || return 1
      printf '\nStage Manager etkin.\n'
      ;;
    *)
      printf '%s: bilinmeyen wm modu: %s\n\n' "$PROGRAM_NAME" "$mode" >&2
      print_wm_mode_usage >&2
      return 2
      ;;
  esac

  return 0
}

reload_all() {
  local reload_status=0

  reload_skhd || reload_status=1
  printf '\n'
  reload_yabai || reload_status=1

  if [ "$reload_status" -eq 0 ]; then
    printf "\nTüm config'ler yenilendi.\n"
  fi
  return "$reload_status"
}

case "${1:-help}" in
  binds)
    case "${2:-help}" in
      config)
        [ "$#" -eq 2 ] || fail "binds config ek argüman kabul etmiyor."
        open_in_editor "$(resolve_skhd_config)"
        ;;
      reload)
        [ "$#" -eq 2 ] || fail "binds reload ek argüman kabul etmiyor."
        reload_skhd || exit 1
        ;;
      help|-h|--help)
        [ "$#" -le 2 ] || fail "binds help ek argüman kabul etmiyor."
        print_binds_usage
        ;;
      *)
        printf '%s: bilinmeyen binds komutu: %s\n\n' "$PROGRAM_NAME" "$2" >&2
        print_binds_usage >&2
        exit 2
        ;;
    esac
    ;;
  wm)
    case "${2:-help}" in
      config)
        [ "$#" -eq 2 ] || fail "wm config ek argüman kabul etmiyor."
        open_in_editor "$(resolve_yabai_config)"
        ;;
      reload)
        [ "$#" -eq 2 ] || fail "wm reload ek argüman kabul etmiyor."
        reload_yabai || exit 1
        ;;
      mode)
        if [ "$#" -eq 2 ]; then
          print_wm_mode_usage
        elif [ "$#" -eq 3 ]; then
          switch_wm_mode "$3" || exit $?
        else
          fail "wm mode yalnızca bir mod kabul ediyor."
        fi
        ;;
      help|-h|--help)
        [ "$#" -le 2 ] || fail "wm help ek argüman kabul etmiyor."
        print_wm_usage
        ;;
      *)
        printf '%s: bilinmeyen wm komutu: %s\n\n' "$PROGRAM_NAME" "$2" >&2
        print_wm_usage >&2
        exit 2
        ;;
    esac
    ;;
  reload)
    [ "$#" -eq 1 ] || fail "reload ek argüman kabul etmiyor."
    reload_all || exit 1
    ;;
  kitty)
    [ "$#" -eq 1 ] || fail "kitty ek argüman kabul etmiyor."
    open_in_editor "$(resolve_kitty_config)"
    ;;
  zsh)
    [ "$#" -eq 1 ] || fail "zsh ek argüman kabul etmiyor."
    open_in_editor "$(resolve_zsh_config)"
    ;;
  doctor)
    [ "$#" -eq 1 ] || fail "doctor ek argüman kabul etmiyor."
    doctor
    ;;
  update)
    [ "$#" -eq 1 ] || fail "update ek argüman kabul etmiyor."
    update_homebrew
    ;;
  help|-h|--help)
    print_usage
    ;;
  version|-v|--version)
    printf '%s %s\n' "$PROGRAM_NAME" "$VERSION"
    ;;
  *)
    printf '%s: bilinmeyen komut: %s\n\n' "$PROGRAM_NAME" "$1" >&2
    print_usage >&2
    exit 2
    ;;
esac
